rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    match /studyMaterials/{document=**} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /classes/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /exams/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /materialTypes/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /academicYears/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    
    match /videos/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    match /quizzes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /admins/{userId} {
      allow read: if true; 
      allow write: if isAdmin() || (request.auth != null && request.auth.token.email == 'tukukalandi@gmail.com');
    }
  }
}
